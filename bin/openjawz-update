#!/usr/bin/env bash
# openjawz-update: lock → brain backup → snapshot → pacman -Syu openjawz-meta → migrate → daemon reload → ambient → doctor
# usage: openjawz update [--yes] [--no-snapshot] [--local DIR]   (--local: transient unsigned repo, never written to /etc)
# owner: openjawz-core
# ci: fast
set -euo pipefail
. "${OPENJAWZ_LIB:-/usr/lib/openjawz}/openjawz.sh"
oj::paths
snap=1; local_dir=""
while [ $# -gt 0 ]; do
  case "$1" in
    --yes|-y) export OPENJAWZ_YES=1 ;;
    --no-snapshot) snap=0 ;;
    --local) local_dir="${2:?--local needs DIR}"; shift ;;
    -h|--help) sed -n '2,4p' "$0"; exit 0 ;;
    *) oj::die "update: unknown flag $1" ;;
  esac; shift
done
oj::is_root && oj::die "run as your user, not root"
umask 077
log="$OPENJAWZ_STATE/update.log"; mkdir -p "$OPENJAWZ_STATE"

# full transcript is the only useful bug report. The re-exec must happen BEFORE the lock (the child inherits the fd).
if [ -z "${OPENJAWZ_UPDATE_LOGGED:-}" ] && oj::have script && [ -t 1 ]; then
  export OPENJAWZ_UPDATE_LOGGED=1
  args=(); [ "$snap" = 0 ] && args+=(--no-snapshot); [ -n "$local_dir" ] && args+=(--local "$local_dir"); oj::yes && args+=(--yes)
  exec script -qefc "$(printf '%q ' "$0" "${args[@]}")" "$log"
fi
oj::lock update

# local unsigned repo (boot --local): the marker says so; the repo is transient, /etc is never touched
marker="$OPENJAWZ_CONFIG/local-repo"
[ -n "$local_dir" ] || case "${OPENJAWZ_REPO:-}" in file://*) local_dir="${OPENJAWZ_REPO#file://}" ;; esac
if [ -e "$marker" ] && [ -z "$local_dir" ]; then
  oj::die "installed from a local unsigned repo ($(cat "$marker")); run: openjawz update --local DIR" 2
fi
if [ -n "$local_dir" ]; then
  local_dir="$(cd "$local_dir" && pwd)" || oj::die "no such directory $local_dir" 2
  { [ -r "$local_dir/openjawz.db" ] && compgen -G "$local_dir/openjawz-meta-*.pkg.tar.zst" >/dev/null; } ||
    oj::die "$local_dir is not a built repo (packages/build-repo.sh --no-sign --out DIR)" 2
  printf '\e[31m!! UNSIGNED LOCAL REPO (test mode) %s\e[0m\n' "$local_dir" >&2
fi

# wait for pacman
i=0; while [ -e /var/lib/pacman/db.lck ]; do
  [ "$i" = 0 ] && oj::log warn "waiting for pacman (/var/lib/pacman/db.lck)…"
  i=$((i+1)); [ "$i" -gt 900 ] && oj::die "pacman lock held for 900 s; giving up"
  sleep 1
done

# brain backup (tarball, keep 3) — ours regardless of filesystem
brain_backup() {
  if openjawz help brain >/dev/null 2>&1; then openjawz brain backup >/dev/null 2>&1 && return 0; fi
  local dir="$OPENJAWZ_STATE/backups"; mkdir -p "$dir"
  [ -d "$OPENJAWZ_HOME" ] || return 0
  tar --zstd -cf "$dir/brain-$(date +%s).tar.zst" -C "$(dirname "$OPENJAWZ_HOME")" "$(basename "$OPENJAWZ_HOME")" 2>/dev/null || return 0
  ls -1t "$dir"/brain-*.tar.zst 2>/dev/null | tail -n +4 | xargs -r rm -f
}
brain_backup && oj::log ok "brain backup → $OPENJAWZ_STATE/backups"

# snapshot: exit 127 = deliberately absent (continue silently); 1 = present but nothing captured (yellow)
snapshot() {
  oj::have snapper || return 127
  [ "$(findmnt -no FSTYPE / 2>/dev/null)" = btrfs ] || { echo "root is not btrfs"; return 127; }
  pacman -Q snap-pac >/dev/null 2>&1 && { echo "snap-pac present — pacman takes pre/post snapshots itself"; return 0; }
  local sudo cfgs c; sudo="$(oj::sudo)"
  mapfile -t cfgs < <($sudo snapper --csvout list-configs 2>/dev/null | awk -F, 'NR>1{print $1}')
  [ "${#cfgs[@]}" -gt 0 ] || return 1
  for c in "${cfgs[@]}"; do $sudo snapper -c "$c" create -c number -d "openjawz update $(oj::version) $(date -Is)" || return 1; done
}
if [ "$snap" = 1 ]; then
  rc=0; out="$(snapshot 2>&1)" || rc=$?
  case "$rc" in
    0) oj::log ok "snapshot: ${out:-done}" ;;
    127) oj::log info "snapshot: none (${out:-snapper not installed}) — brain backup only" ;;
    *) oj::log warn "snapshot: snapper has no configs; nothing captured (sudo snapper -c root create-config /). Continuing without a snapshot." ;;
  esac
fi

# pacman
sudo="$(oj::sudo)"
if [ -n "$local_dir" ]; then
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  cp /etc/pacman.conf "$tmp/pacman.conf"
  # pacman>=7 downloads as user alpm: stage a world-readable copy (a 0700 $HOME is unreadable to it); same as boot --local
  stage=$(mktemp -d /tmp/openjawz-repo.XXXXXX); chmod 755 "$stage"; cp -r "$local_dir"/. "$stage"/; chmod -R a+rX "$stage"
  trap 'rm -rf "$tmp" "$stage"' EXIT
  oj::run $sudo rm -f /var/lib/pacman/sync/openjawz.db.sig /var/lib/pacman/sync/openjawz.files.sig   # signed→local: stale .sig breaks -Sy
  printf '\n[openjawz]\nSigLevel = Optional TrustAll\nServer = file://%s\n' "$stage" >> "$tmp/pacman.conf"
  # a stale signed db from an earlier signed repo would poison the unsigned sync
  oj::run $sudo rm -f /var/lib/pacman/sync/openjawz.db /var/lib/pacman/sync/openjawz.files /var/lib/pacman/sync/openjawz.db.sig /var/lib/pacman/sync/openjawz.files.sig
  oj::run $sudo pacman --config "$tmp/pacman.conf" -Syu --needed ${OPENJAWZ_YES:+--noconfirm} openjawz-meta
  printf '%s\n' "$local_dir" > "$marker"
else
  oj::run $sudo pacman -Syu --needed ${OPENJAWZ_YES:+--noconfirm} openjawz-meta
fi

# migrations
oj::log info "migrations:"
openjawz migrate ${OPENJAWZ_YES:+--yes}

# daemon reload; restart on refusal
oj::log info "reloading the daemon (drains up to 30 s)"
if oj::daemon_alive; then
  if out="$(synaps daemon reload --json --exe "$(command -v synaps)" 2>&1)"; then oj::log ok "daemon reloaded in place"
  else oj::log warn "reload refused ($(printf '%s' "$out" | tail -1)); restarting the unit"; systemctl --user restart synaps-daemon.service; fi
else
  systemctl --user restart synaps-daemon.service 2>/dev/null || true
fi
# the ambient session does not survive a restart on its own (oneshot unit) — put it back
openjawz ambient ensure >/dev/null 2>&1 || oj::log warn "ambient session not restored — openjawz ambient ensure"
echo
openjawz doctor --brief || true
