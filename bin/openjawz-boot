#!/usr/bin/env bash
# openjawz-boot: the boot briefing — Identity → Work → World (boot.d/ sections run in parallel)
# usage: openjawz boot [--quiet] [--no-world]
# owner: openjawz-ops
# ci: fast
#
# Identity: last journal entry.  Work: handoff, checkpoint (⚠ if unclean), tasks, recent sessions, active projects.
# World: every executable in /usr/share/openjawz/ops/boot.d/ and $OPENJAWZ_CONFIG/boot.d/ (parallel, 8 s cap).
# The brain is NOT recalled here — the axel extension injects on session start (no double context).
set -euo pipefail
export OJ_CMD=boot
# shellcheck source=../ops/lib/source-lib.sh
. "$(dirname "$(readlink -f "$0")")/../ops/lib/source-lib.sh"
usage() { sed -n '2,4p' "$0" | sed 's/^# //'; }
QUIET=0 WORLD=1
for a in "$@"; do case $a in -h|--help) usage; exit 0;; --quiet) QUIET=1;; --no-world) WORLD=0;; *) usage; exit 2;; esac; done
export NO_COLOR=1
A="$OPENJAWZ_HOME/context/active"
TOOLS="${OPENJAWZ_TOOLS:-/usr/lib/openjawz/tools}"
[ -x "$TOOLS/openjawz-tasks" ] || TOOLS="$(dirname "$(readlink -f "$0")")/../ops/tools"
tool() { local n=$1; shift; if [ -x "$TOOLS/openjawz-$n" ]; then "$TOOLS/openjawz-$n" "$@"; elif [ -x "$TOOLS/$n" ]; then "$TOOLS/$n" "$@"; else return 127; fi; }
h() { printf '\n## %s\n' "$1"; }
[ -d "$A" ] || oj::die "no engram at $OPENJAWZ_HOME — run: openjawz onboard" 2

# ── World first, in the background (it is slowest); printed last ─────────────
if [ $WORLD = 1 ]; then
  world_tmp=$(mktemp -d)
  for d in "$OPENJAWZ_SHARE/ops/boot.d" "$OPENJAWZ_CONFIG/boot.d"; do
    [ -d "$d" ] || continue
    for s in "$d"/*; do
      [ -x "$s" ] || continue
      ( timeout 8 "$s" > "$world_tmp/$(basename "$s")" 2>/dev/null || true ) &
    done
  done
fi

printf '# Boot — %s — %s\n' "${AGENT_NAME:-agent}" "$(date '+%A %Y-%m-%d %H:%M %Z')"

# ── Identity ─────────────────────────────────────────────────────────────────
h "Identity"
last_journal=$(ls -1 "$OPENJAWZ_HOME/notes/journal/"*.md 2>/dev/null | sort | tail -1 || true)
if [ -n "$last_journal" ]; then
  printf 'Last journal: %s\n' "$(basename "$last_journal" .md)"
  [ $QUIET = 1 ] || sed -n '1,12p' "$last_journal"
else
  echo "No journal yet. First entry: $OPENJAWZ_HOME/notes/journal/$(date -I).md"
fi

# ── Work ─────────────────────────────────────────────────────────────────────
h "Handoff"
if [ -s "$A/handoff.md" ]; then cat "$A/handoff.md"; else echo "No active handoff."; fi

if [ -s "$A/checkpoint.md" ] && { grep -q UNCLEAN "$A/checkpoint.md" || ! tail -1 "$A/checkpoint.md" | grep -qiE 'completed|no in-flight|— none'; }; then
  h "⚠ Checkpoint — UNCLEAN SHUTDOWN (previous session did not run openjawz shutdown)"
  cat "$A/checkpoint.md"
fi

h "Tasks"
tool tasks list 2>/dev/null | head -25 || echo "(tasks tool unavailable)"
due=$(tool tasks due 2>/dev/null | head -8 || true); [ -n "$due" ] && { echo; echo "Due:"; echo "$due"; }

h "Recent sessions"
tool sessions recent 3 2>/dev/null || sed -n '1,8p' "$A/sessions_recent.md" 2>/dev/null || echo "(none)"

h "Active projects"
if [ -s "$A/projects_active.md" ]; then
  if [ $QUIET = 1 ]; then grep -E '^#{1,3} ' "$A/projects_active.md" | head -20; else sed -n '1,40p' "$A/projects_active.md"; fi
else echo "(none)"; fi

# ── World ────────────────────────────────────────────────────────────────────
if [ $WORLD = 1 ]; then
  wait
  for f in "$world_tmp"/*; do
    [ -s "$f" ] || continue
    h "$(basename "$f" | sed -E 's/^[0-9]+-//')"; cat "$f"
  done
  rm -rf "$world_tmp"
fi
printf '\n— boot complete. Checkpoint every ~10 exchanges (`openjawz checkpoint`); `openjawz shutdown` before you leave.\n'
