#!/usr/bin/env bash
# openjawz-track-lib — source at the top of any bash tool:
#   . "${OPENJAWZ_TOOLS:-/usr/lib/openjawz/tools}/lib/openjawz-track-lib"
# On exit it logs tool name, duration, exit code and caller to `toolstats`.
# Fire-and-forget — backgrounded, never blocks, never fails the tool. Opt out: OPENJAWZ_NO_TRACK=1.
# shellcheck shell=bash

_OJ_TRACK_START=$(date +%s%N 2>/dev/null || echo 0)
_OJ_TRACK_TOOL=$(basename "$0"); _OJ_TRACK_TOOL=${_OJ_TRACK_TOOL#openjawz-}

_oj_track_exit() {
    local exit_code=$? end duration_ms=0 caller bin
    [ "${OPENJAWZ_NO_TRACK:-0}" = 1 ] && return "$exit_code"
    end=$(date +%s%N 2>/dev/null || echo 0)
    if [ "$_OJ_TRACK_START" != 0 ] && [ "$end" != 0 ]; then
        duration_ms=$(( (end - _OJ_TRACK_START) / 1000000 ))
    fi
    caller="${OPENJAWZ_AGENT:-user}"
    bin="${OPENJAWZ_TOOLS:-/usr/lib/openjawz/tools}/openjawz-toolstats"
    [ -x "$bin" ] || bin=$(command -v openjawz-toolstats 2>/dev/null) || return "$exit_code"
    ("$bin" log "$_OJ_TRACK_TOOL" --duration "$duration_ms" --exit-code "$exit_code" --caller "$caller" >/dev/null 2>&1 &)
    return "$exit_code"
}
trap '_oj_track_exit' EXIT
