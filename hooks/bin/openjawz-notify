#!/usr/bin/env bash
# openjawz-notify: toast the user; "Attach" action summons the session
# usage: openjawz notify [-u low|normal|critical] [-r ID] [-p] [--no-action] <summary> [body]
# owner: openjawz-hooks
# ci: fast
#
# Wraps notify-send -a OpenJAWZ. With a notification daemon that supports actions, the toast
# carries an "Attach" button → `openjawz summon`. -A implies --wait, so the action wait runs
# in the background and this command returns at once. -p prints the id (use -r ID to replace:
# progress toasts). Exit 2 when libnotify or the session bus is absent (stage contract: skip).
set -euo pipefail
_lib=${OPENJAWZ_LIB:-/usr/lib/openjawz}/openjawz.sh
[ -r "$_lib" ] || _lib=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/lib/openjawz.sh
# shellcheck source=/dev/null
. "$_lib"
oj::paths
export OJ_CMD=notify

urg=normal replace='' print=0 action=1
while [ $# -gt 0 ]; do
  case $1 in
    -u|--urgency) urg=$2; shift 2 ;;
    -r|--replace-id) replace=$2; shift 2 ;;
    -p|--print-id) print=1; shift ;;
    --no-action) action=0; shift ;;
    -h|--help) sed -n '2,4p' "$0" | sed 's/^# //'; exit 0 ;;
    --) shift; break ;;
    -*) oj::die "unknown flag: $1" 2 ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { sed -n '3p' "$0" | sed 's/^# //'; exit 2; }
summary=$1; body=${2:-}
case $urg in low|normal|critical) ;; *) urg=normal ;; esac

oj::have notify-send || { oj::log warn "libnotify not installed; toast: $summary${body:+ — $body}"; exit 2; }
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  bus=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus
  [ -S "$bus" ] || { oj::log warn "no session bus; toast: $summary${body:+ — $body}"; exit 2; }
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$bus"
fi

args=(-a OpenJAWZ -i dialog-information -u "$urg")
[ -n "$replace" ] && args+=(-r "$replace")
[ "$print" = 1 ] && args+=(-p)

if [ "$action" = 1 ] && [ "$print" = 0 ] && oj::have openjawz; then
  # -A blocks until the toast closes; detach so callers (the ambient session, scripts) return now
  (
    choice=$(notify-send "${args[@]}" -A attach=Attach "$summary" "$body" 2>/dev/null || true)
    [ "$choice" = attach ] && exec openjawz summon
  ) >/dev/null 2>&1 < /dev/null &
  disown
  exit 0
fi
exec notify-send "${args[@]}" "$summary" "$body"
