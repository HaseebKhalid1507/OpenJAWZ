[Unit]
Description=OpenJAWZ ambient session (ensure it exists after the daemon is up)
Documentation=https://github.com/HaseebKhalid1507/OpenJAWZ
After=synaps-daemon.service
Wants=synaps-daemon.service
# lives and dies with the daemon: a daemon restart (crash, update) stops this unit, and the
# daemon's Upholds= starts it again → `ambient ensure` re-runs → the session is back.
BindsTo=synaps-daemon.service
PartOf=synaps-daemon.service
# `ensure` calls the model (attach --create); if it keeps failing, Upholds= must not retry it forever
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-%E/openjawz/profile.env
EnvironmentFile=-%E/openjawz/env
ExecStart=/usr/bin/openjawz ambient ensure
# ensure's worst case: daemon start 10 s + --continue 40 s + --create 60 s = 110 s
TimeoutStartSec=130

[Install]
WantedBy=default.target
