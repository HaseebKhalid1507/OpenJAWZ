#!/usr/bin/env bash
# waybar-status: one JSON line for a Waybar custom module (sessions · lifecycle · owner · memory)
# usage: waybar exec /usr/lib/openjawz/ui/waybar-status; also `openjawz waybar-status` for a manual look
# owner: openjawz-ui
# ci: fast
#
# Contract: {"text","alt","class":[…],"tooltip"} on one line. class ∈ off|empty|parked|idle|attached|busy
# (+ "pending" when migrations wait, cached 60 s).
#   off      daemon not running — unit inactive, or (no unit) `synaps daemon status` ≠ 0 (a stale socket is off, not idle)
#   empty    daemon up, zero sessions
#   parked   only parked sessions
#   idle     a live session, nobody typing, no turn in flight
#   attached a terminal owns a live session's input (a human is there — not "work")
#   busy     ONLY when the runtime reports a turn in flight (`turn_active`/`streaming`); omitted otherwise
# NEVER touches the daemon socket while synaps-daemon.service is inactive — a poll must not wake anything;
# with no unit, `daemon status` is the probe (it never auto-spawns). Memory = `synaps status --memory --json
# --pid <daemon.pid>` (one tree, correct totals; bare --memory counts the daemon once per session).
set -uo pipefail
_lib=${OPENJAWZ_LIB:-/usr/lib/openjawz}/openjawz.sh
[ -r "$_lib" ] || _lib=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/lib/openjawz.sh
# shellcheck source=/dev/null
. "$_lib"
oj::paths

out() { jq -cn --arg t "$1" --arg a "$2" --argjson c "$3" --arg tip "$4" '{text:$t,alt:$a,class:$c,tooltip:$tip}'; }

pending_class() {
  local cache=$OPENJAWZ_RUN/migrate.pending now
  now=$(date +%s)
  if [ ! -e "$cache" ] || [ $((now - $(stat -c %Y "$cache" 2>/dev/null || echo 0))) -gt 60 ]; then
    mkdir -p "$OPENJAWZ_RUN"
    if oj::have openjawz; then openjawz migrate --pending 2>/dev/null | grep -qv '^none' && echo 1 > "$cache" || echo 0 > "$cache"
    else echo 0 > "$cache"; fi
  fi
  [ "$(cat "$cache" 2>/dev/null)" = 1 ] && echo ',"pending"' || true
}

alive=1
if oj::have systemctl && systemctl --user list-unit-files synaps-daemon.service 2>/dev/null | grep -q '^synaps-daemon.service'; then
  systemctl --user -q is-active synaps-daemon.service 2>/dev/null || alive=0
fi
# the file is not the daemon: probe (daemon status detects a dead pid and never spawns)
[ "$alive" = 1 ] && { SYNAPS_DAEMON_AUTOSPAWN=0 timeout 3 synaps daemon status >/dev/null 2>&1 || alive=0; }
if [ "$alive" = 0 ]; then
  out "" off "[\"off\"$(pending_class)]" "daemon off — summon starts it"; exit 0
fi

sessions=$(SYNAPS_DAEMON_AUTOSPAWN=0 timeout 3 synaps daemon sessions --json 2>/dev/null) || sessions='[]'
jq -e 'type=="array"' <<<"$sessions" >/dev/null 2>&1 || sessions='[]'
live=$(jq '[.[]|select(.lifecycle=="live")]|length' <<<"$sessions")
parked=$(jq '[.[]|select(.lifecycle=="parked" or .lifecycle=="parking")]|length' <<<"$sessions")
attached=$(jq '[.[]|select(.lifecycle=="live" and .clients>0 and .input_owner!=null)]|length' <<<"$sessions")
busy=$(jq '[.[]|select(.lifecycle=="live" and ((.turn_active // .streaming // .busy // false)==true))]|length' <<<"$sessions")

mem=""
pidf=$SYNAPS_RUN/daemon.pid
if [ -r "$pidf" ]; then
  kb=$(timeout 3 synaps status --memory --json --pid "$(cat "$pidf")" 2>/dev/null | jq -r '.totals.pss_kb // .totals.rss_kb // empty')
  [ -n "$kb" ] && mem="$((kb / 1024))M"
fi

if   [ "$busy" -gt 0 ]; then state=busy
elif [ "$attached" -gt 0 ]; then state=attached
elif [ "$live" -gt 0 ]; then state=idle
elif [ "$parked" -gt 0 ]; then state=parked
else state=empty; fi

if [ "$state" = empty ]; then text="no sessions${mem:+ · $mem}"; else text="$live live · $parked parked${mem:+ · $mem}"; fi
tip=$(jq -r '.[] | "\(.id)  \(.lifecycle)  clients=\(.clients)  owner=\(.input_owner // "-")  \(.name // "")"' <<<"$sessions" | paste -sd '\r' -)
[ -n "$tip" ] || tip="no sessions"
out "$text" "$state" "[\"$state\"$(pending_class)]" "$tip"
