#!/usr/bin/env bash
# openjawz-migrate: run pending migrations once, per user, with a dirty flag
# usage: openjawz migrate [--pending|--list|--seed-all|--force <name>|--skip <name>|--notify] [--yes]
# owner: openjawz-core
# ci: fast
set -euo pipefail
. "${OPENJAWZ_LIB:-/usr/lib/openjawz}/openjawz.sh"
oj::paths
src="$OPENJAWZ_SHARE/migrations"
mark="$OPENJAWZ_STATE/migrations"
mkdir -p "$mark"

mode=run; target=""
while [ $# -gt 0 ]; do
  case "$1" in
    --pending|--list|--seed-all|--notify) mode="${1#--}" ;;
    --force|--skip) mode="${1#--}"; target="${2:?--$mode needs <name>}"; shift ;;
    --yes|-y) export OPENJAWZ_YES=1 ;;
    -h|--help) sed -n '2,4p' "$0"; exit 0 ;;
    *) oj::die "migrate: unknown flag $1" ;;
  esac; shift
done

files=()
if [ -d "$src" ]; then
  while IFS= read -r f; do files+=("$f"); done < <(find "$src" -maxdepth 1 -name '[0-9]*-*.sh' -printf '%f\n' | sort)
fi
pending=(); for f in "${files[@]}"; do [ -e "$mark/$f" ] || pending+=("$f"); done
dirty=(); for d in "$mark"/*.running; do [ -e "$d" ] && dirty+=("$(basename "$d" .running)"); done

case "$mode" in
  pending) if [ "${#pending[@]}" = 0 ]; then echo none; else printf '%s\n' "${pending[@]}"; fi; exit 0 ;;
  list)
    for f in "${files[@]}"; do
      if [ -e "$mark/$f.running" ]; then s=RUNNING; elif [ -e "$mark/$f" ]; then s="done"; else s=pending; fi
      printf '%-8s %s\n' "$s" "$f"
    done; exit 0 ;;
  seed-all) for f in "${files[@]}"; do : > "$mark/$f"; done; echo "seeded ${#files[@]} marker(s)"; exit 0 ;;
  notify)
    [ "${#pending[@]}" = 0 ] && exit 0
    oj::have notify-send && notify-send -a OpenJAWZ "OpenJAWZ: ${#pending[@]} pending migration(s)" "Run: openjawz migrate" || true
    exit 0 ;;
  skip) [ -e "$src/$target" ] || oj::die "no such migration $target"; rm -f "$mark/$target.running"; : > "$mark/$target"; echo "skipped $target"; exit 0 ;;
  force) [ -e "$src/$target" ] || oj::die "no such migration $target"; rm -f "$mark/$target.running" "$mark/$target"; pending=("$target"); dirty=() ;;
esac

if [ "${#dirty[@]}" -gt 0 ]; then
  oj::log err "a previous migration did not finish: ${dirty[*]}"
  oj::log err "fix it, then: openjawz migrate --force <name>   (or --skip <name>)"
  exit 1
fi
[ "${#pending[@]}" = 0 ] && { echo none; exit 0; }

if [ "$mode" = run ] && openjawz help brain >/dev/null 2>&1; then
  openjawz brain backup --quick >/dev/null 2>&1 || true
fi

for f in "${pending[@]}"; do
  scope="$(printf '%s' "$f" | cut -d- -f2)"
  oj::log info "migrate: $f"
  : > "$mark/$f.running"
  if [ "$scope" = system ]; then
    echo "--- $f (system scope) will run under sudo:"; sed -n '1,40p' "$src/$f"; echo '---'
    if t="$(oj::tty)"; then
      printf 'run it? [y/N] '; read -r ans < "$t" || ans=n
      [ "$ans" = y ] || [ "$ans" = Y ] || { rm -f "$mark/$f.running"; oj::die "migrate: refused $f" 1; }
    fi
    if ! "$(oj::sudo)" bash -euo pipefail "$src/$f" 3<&-; then oj::log err "migrate: $f FAILED (.running kept)"; exit 1; fi
  else
    if ! bash -euo pipefail "$src/$f" 3<&-; then oj::log err "migrate: $f FAILED (.running kept)"; exit 1; fi
  fi
  mv "$mark/$f.running" "$mark/$f"
  printf '%s %s ok\n' "$(date -Is)" "$f" >> "$OPENJAWZ_STATE/migrate.log"
  echo "migrated $f"
done
