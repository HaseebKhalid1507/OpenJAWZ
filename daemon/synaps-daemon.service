[Unit]
Description=Synaps daemon (OpenJAWZ)
Documentation=https://github.com/HaseebKhalid1507/OpenJAWZ
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-%E/openjawz/profile.env
EnvironmentFile=-%E/openjawz/env
Environment=OPENJAWZ_HOME=%h/.local/share/openjawz
ExecStart=/usr/lib/openjawz/bin/openjawz-daemon-exec
RuntimeDirectory=openjawz
RuntimeDirectoryPreserve=yes
KillSignal=SIGTERM
TimeoutStopSec=90
Restart=on-failure
RestartSec=1s
RestartPreventExitStatus=3
Slice=app.slice
OOMScoreAdjust=-100

[Install]
WantedBy=default.target
